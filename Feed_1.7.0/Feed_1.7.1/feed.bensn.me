server {
    server_name feed.bensn.me;
    client_max_body_size 20M;

    # ── Statische Seiten ohne Auth ──
    location = /shared       { root /var/www/feed/public; try_files /shared.html =404; }
    location = /shared.html  { root /var/www/feed/public; }

    # /s/<token> — Empfänger-Feed (kein Auth)
    location ~ ^/s(/.*)?$    { root /var/www/feed/public; try_files /s.html =404; }

    # ── API ohne Auth ──
    location = /api/feed/shared {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /api/feed/combined/shared {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /api/oembed {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # /api/share/<token> — öffentlich
    location ~ ^/api/share/ {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ── API mit Basic Auth ──
    location /api/ {
        auth_basic "bensn feed";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ── Static ohne Auth ──
    location /shared/ { alias /var/www/shared/; }
    location /uploads/ { root /var/www/feed/public; }

    # ── Hauptseite (JS-Modal übernimmt Auth) ──
    location / {
        root /var/www/feed/public;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/feed.bensn.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/feed.bensn.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
server {
    if ($host = feed.bensn.me) { return 301 https://$host$request_uri; }
    listen 80;
    server_name feed.bensn.me;
    return 404;
}
