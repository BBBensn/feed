server {
    server_name feed.bensn.me;
    client_max_body_size 20M;

    # Shared — kein Auth
    location = /shared { root /var/www/feed/public; try_files /shared.html =404; }
    location = /shared.html { root /var/www/feed/public; }

    # API shared — kein Auth (muss VOR dem /api/ Block stehen)
    location = /api/feed/shared {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /api/feed/combined/shared {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location = /api/oembed {
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # API — Basic Auth
    location /api/ {
        auth_basic "bensn feed";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://127.0.0.1:5002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Static files — kein Auth
    location /shared/ { alias /var/www/shared/; }
    location /uploads/ { root /var/www/feed/public; }

    # Hauptseite — kein Auth (JS-Modal übernimmt)
    location / {
        root /var/www/feed/public;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/feed.bensn.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/feed.bensn.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
server {
    if ($host = feed.bensn.me) { return 301 https://$host$request_uri; }
    listen 80;
    server_name feed.bensn.me;
    return 404;
}
